@model IEnumerable<PetCrud.Models.Animal>

@{
    ViewData["Title"] = "Index";
}
<div style="text-align:center">
    <h1>Cadastro de Animal</h1>
</div>

<p>
  <a class="btn btn-primary" asp-action="Create">Cadastre seu Animal</a>
</p>
<table class="table table-success table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Idade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Raca)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Idade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Raca)
            </td>
            <td>
                <a class="btn btn-success" asp-action="Edit" asp-route-id="@item.IdAnimal">Editar</a> |
                <a class="btn btn-warning" asp-action="Details" asp-route-id="@item.IdAnimal">Informações</a> |
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.IdAnimal">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
