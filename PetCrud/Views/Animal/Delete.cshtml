@model PetCrud.Models.Animal

@{
    ViewData["Title"] = "Delete";
}

<div style="text-align:center">
    <h1>Excluir Cadastro</h1>

    <h4>Animal</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Idade)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Idade)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Raca)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Raca)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdAnimal" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a class="btn btn-primary" asp-action="Index">Voltar par lista</a>
    </form>
</div>
